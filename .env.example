OLLAMA_BASE_URL=http://localhost:11434

# Faster options: qwen2.5:1.5b  qwen2.5:3b  qwen2.5:7b (default)
MODEL_NAME=qwen2.5

EMBED_MODEL=nomic-embed-text
CHROMA_PATH=./data/chroma
DB_URL=sqlite:///./data/studylens.db
UPLOAD_PATH=./data/uploads

# Tuning: smaller = faster embedding + faster LLM responses
CHUNK_SIZE=256
CHUNK_OVERLAP=32
RAG_TOP_K=3
