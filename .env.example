# OpenRouter settings. Create a key at https://openrouter.ai/keys.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_EMBED_MODEL=openai/text-embedding-3-small
OPENROUTER_APP_NAME=StudyLens
# Optional: URL shown in OpenRouter app attribution/rankings.
OPENROUTER_HTTP_REFERER=
CHROMA_PATH=./data/chroma
DB_URL=sqlite:///./data/studylens.db
UPLOAD_PATH=./data/uploads

# Tuning: smaller = faster embedding + faster LLM responses
CHUNK_SIZE=256
CHUNK_OVERLAP=32
RAG_TOP_K=3
